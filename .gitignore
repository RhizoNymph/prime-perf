# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

.claude/
.prime

# Prime lab generated files
configs/eval/minimal.toml
configs/eval/multi-env.toml
configs/gepa/
configs/prime-rl/wiki-search.toml
configs/endpoints.toml
environments

# Perf references
*.bin
problems/*/*.bin
# Per-size sized perf inputs and tests/expected pairs define the problem bank
# and must be tracked — without these, the environment cannot be loaded.
!problems/*/perf_inputs/*.bin
!problems/*/tests/*.bin
# Held-out test/perf bins are part of the eval contract and must be tracked.
!problems/*/tests_heldout/*.bin
!problems/*/perf_inputs_heldout/*.bin

AGENTS.md
CLAUDE.md
